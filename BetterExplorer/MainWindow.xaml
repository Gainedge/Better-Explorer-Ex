<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BetterExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BetterExplorer">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="45" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar drag region -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" />

    <!-- Full-featured browser control: nav bar + tree + list -->
    <controls:ExplorerBrowser x:Name="Browser" Grid.Row="1" />
  </Grid>
</Window>
