<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BetterExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BetterExplorer">

  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>

  <!-- Tabbed file browser – tab strip lives in the title bar area. -->
  <controls:TabbedExplorerBrowser x:Name="TabbedBrowser" />

</Window>
