<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterExplorer.Controls.ShellListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellapi="using:BetterExplorer.ShellApi"
    xmlns:local="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="ShellListView_Loaded"
    Unloaded="ShellListView_Unloaded">

  <UserControl.Resources>

    <!-- Shared column-width state — both the header and each item row bind to this. -->
    <shellapi:DetailsColumnSettings x:Key="DetailsColumns" />

    <!-- Fixed height for the details column header row. Applied to both the header
         grid and each DataTemplate item so the gripper Border stretches fully. -->
    <x:Double x:Key="DetailsHeaderHeight">35</x:Double>

    <!-- ═══════════════════════════════════════════════
             Rename TextBox — no delete/clear button
        ════════════════════════════════════════════════ -->
    <Style x:Key="RenameTextBoxStyle" TargetType="TextBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
      <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
      <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="{ThemeResource TextControlBorderThemeThickness}" />
      <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
      <Setter Property="Padding" Value="4,2,4,2" />
      <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
      <Setter Property="SelectionHighlightColor" Value="{ThemeResource TextControlSelectionHighlightColor}" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="BorderElement.Opacity" Value="0.38" />
                      <Setter Target="ContentElement.Opacity" Value="0.38" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="BorderElement.BorderBrush"
                              Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                      <Setter Target="BorderElement.Background"
                              Value="{ThemeResource TextControlBackgroundPointerOver}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Focused">
                    <VisualState.Setters>
                      <Setter Target="BorderElement.BorderBrush"
                              Value="{ThemeResource TextControlBorderBrushFocused}" />
                      <Setter Target="BorderElement.Background"
                              Value="{ThemeResource TextControlBackgroundFocused}" />
                      <Setter Target="FocusAccentBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <!-- Background + border chrome -->
              <Border x:Name="BorderElement"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{ThemeResource ControlCornerRadius}" />

              <!-- Accent focus underline (matches WinUI convention) -->
              <Border x:Name="FocusAccentBorder"
                      BorderThickness="0,0,0,2"
                      BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                      CornerRadius="{ThemeResource ControlCornerRadius}"
                      Visibility="Collapsed" />

              <!-- Text editing area — MUST be named ContentElement -->
              <ScrollViewer x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            AutomationProperties.AccessibilityView="Raw" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════
             Extra Large Icons  (256 px)
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ExtraLargeIconsTemplate" x:DataType="shellapi:ShellItem">
      <Grid Width="276" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="256" />
          <RowDefinition Height="57" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Width="256" Height="256"
                         Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Grid Width="256" Height="256">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                  FontSize="192"
                                  Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="64" Height="64"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <Canvas Grid.Row="1" Width="276" Height="57" HorizontalAlignment="Left"
                        Visibility="{x:Bind LabelVisibility, Mode=OneWay}">
          <TextBlock Canvas.Top="4" Width="276"
                               Text="{x:Bind DisplayName, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Canvas>
      </Grid>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
             Large Icons  (128 px)
    ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="LargeIconsTemplate" x:DataType="shellapi:ShellItem">
      <Grid Width="148" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="128" />
          <RowDefinition Height="57" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Width="128" Height="128"
                         Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Grid Width="128" Height="128">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                  FontSize="96"
                                  Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="64" Height="64"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <Canvas Grid.Row="1" Width="148" Height="57" HorizontalAlignment="Left"
                        Visibility="{x:Bind LabelVisibility, Mode=OneWay}">
          <TextBlock Canvas.Top="4" Width="148"
                               Text="{x:Bind DisplayName, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Canvas>
      </Grid>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
             Medium Icons  (96 px)
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="MediumIconsTemplate" x:DataType="shellapi:ShellItem">
      <Grid Width="116" Opacity="{x:Bind IconOpacity, Mode=OneWay, FallbackValue=1.0}">
        <Grid.RowDefinitions>
          <RowDefinition Height="96" />
          <RowDefinition Height="57" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Width="96" Height="96"
                         Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Grid Width="96" Height="96">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                  FontSize="72"
                                  Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="48" Height="48"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <Canvas Grid.Row="1" Width="116" Height="57" HorizontalAlignment="Left"
                Visibility="{x:Bind LabelVisibility, Mode=OneWay}">
          <TextBlock Canvas.Top="4" Width="116"
                               Text="{x:Bind DisplayName, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Canvas>
      </Grid>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
             Small Icons  (48 px)
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="SmallIconsTemplate" x:DataType="shellapi:ShellItem">
      <Grid Width="80" Opacity="{x:Bind IconOpacity, Mode=OneWay, FallbackValue=1.0}">
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="57" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Width="48" Height="48"
                     Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Grid Width="48" Height="48">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                              FontSize="36"
                              Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="48" Height="48"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <Canvas Grid.Row="1" Width="80"
            Visibility="{x:Bind LabelVisibility, Mode=OneWay}">
          <TextBlock Canvas.Top="4" Width="80"
                           Text="{x:Bind DisplayName, Mode=OneWay}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Canvas>
      </Grid>
    </DataTemplate>
    <!--<DataTemplate x:Key="SmallIconsTemplate" x:DataType="shellapi:ShellItem">
      <StackPanel Orientation="Horizontal" Width="160" Spacing="4" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Viewbox Width="16" Height="16" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly">
          <Grid Width="16" Height="16">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                              FontSize="12"
                                              Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
          </Grid>
        </Viewbox>
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
      </StackPanel>
    </DataTemplate>-->

    <!-- ═══════════════════════════════════════════════
             List  (16 px icon, single column, tall list)
                         List
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ListTemplate" x:DataType="shellapi:ShellItem">
      <StackPanel Orientation="Horizontal" MinWidth="180" Spacing="6" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Viewbox Width="16" Height="16" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly">
          <Grid Width="16" Height="16">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                              FontSize="12"
                                              Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="8" Height="8"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center"
                                       Visibility="{x:Bind LabelVisibility, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
      </StackPanel>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
                         Details
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="DetailsTemplate" x:DataType="shellapi:ShellItem">
      <!--
        DetailsRowControl builds its cells in code-behind from DetailsColumnSettings.Columns,
        so adding/removing columns at runtime automatically updates every visible row.
      -->
      <local:DetailsRowControl Item="{x:Bind}"
                               Columns="{StaticResource DetailsColumns}"
                               Margin="12,0,0,0" />
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
             Tiles  (48 px icon + 2 lines of metadata)
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="TilesTemplate" x:DataType="shellapi:ShellItem">
      <StackPanel Orientation="Horizontal" Width="260" Spacing="4" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Viewbox Width="48" Height="48" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly">
          <Grid Width="48" Height="48">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                  FontSize="36"
                                  Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="24" Height="24"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                               Visibility="{x:Bind LabelVisibility, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Width="190" />
          <TextBlock Text="{x:Bind ItemType, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Width="190" />
          <TextBlock Text="{x:Bind Size, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Width="190" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════
             Wrap-panel icon modes — item container style
        ════════════════════════════════════════════════ -->
    <Style x:Key="WrapIconListViewItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="FocusVisualMargin" Value="0" />
      <Setter Property="FocusVisualPrimaryThickness" Value="0" />
      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Grid x:Name="RootGrid"
                              Control.IsTemplateFocusTarget="True"
                              IsTabStop="False"
                              CornerRadius="{ThemeResource ControlCornerRadius}"
                              Padding="{TemplateBinding Padding}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="PointerBorder.Background"
                                                    Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="PointerBorder.Background"
                                                    Value="{ThemeResource ListViewItemBackgroundPressed}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="PointerOverPressed">
                    <VisualState.Setters>
                      <Setter Target="PointerBorder.Background"
                                                    Value="{ThemeResource ListViewItemBackgroundPressed}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Opacity"
                                                    Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="SelectionStates">
                  <VisualState x:Name="Unselected" />
                  <VisualState x:Name="Selected">
                    <VisualState.Setters>
                      <Setter Target="SelectionBorder.Visibility"
                                                    Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <!-- Treat unfocused-selected identically to focused-selected so the
                       selection rectangle is always clearly visible. -->
                  <VisualState x:Name="SelectedUnfocused">
                    <VisualState.Setters>
                      <Setter Target="SelectionBorder.Visibility"
                                                    Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="DropTargetStates">
                  <VisualState x:Name="NotDropTarget" />
                  <VisualState x:Name="DropTarget">
                    <VisualState.Setters>
                      <Setter Target="DropTargetBorder.Visibility"
                                                    Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="NameExpansionStates">
                  <VisualState x:Name="NameCollapsed" />
                  <VisualState x:Name="NameExpanded">
                    <VisualState.Setters>
                      <!-- Remove bottom border and bottom corners so the
                                                 popup card appears as a seamless extension. -->
                      <Setter Target="SelectionBorder.BorderThickness" Value="2,2,2,0" />
                      <Setter Target="SelectionBorder.CornerRadius" Value="4,4,0,0" />
                      <Setter Target="RootGrid.CornerRadius" Value="4,4,0,0" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <Border x:Name="SelectionBorder"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Background="{ThemeResource ListViewItemBackgroundSelected}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="Collapsed" />

              <Border x:Name="DropTargetBorder"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="Collapsed" />

              <Border x:Name="PointerBorder"
                                    Background="Transparent"
                                    CornerRadius="{ThemeResource ControlCornerRadius}" />

              <ContentPresenter
                                x:Name="ContentPresenter"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Padding="4"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════
             Content  (48 px icon + name + date + size)
        ════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ContentTemplate" x:DataType="shellapi:ShellItem">
      <Grid ColumnSpacing="10" Opacity="{x:Bind IconOpacity, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Viewbox Width="48" Height="48" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly">
          <Grid Width="48" Height="48">
            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay, FallbackValue=&#xE8A5;}"
                                  FontSize="36"
                                  Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
            <Image Source="{x:Bind OverlayIcon, Mode=OneWay}"
                   Visibility="{x:Bind OverlayIconVisibility, Mode=OneWay}"
                   Width="16" Height="16"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Stretch="Uniform" IsHitTestVisible="False" />
          </Grid>
        </Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                               Visibility="{x:Bind LabelVisibility, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
          <TextBlock Text="{x:Bind DateModifiedString, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

  </UserControl.Resources>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Details header row -->
    <Grid x:Name="DetailsHeader" Grid.Row="0"
              Height="{StaticResource DetailsHeaderHeight}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1" Padding="20,0,8,0">
      <ItemsRepeater x:Name="DetailsHeaderRepeater"
                     VerticalAlignment="Stretch"
                     ItemsSource="{Binding Columns, Source={StaticResource DetailsColumns}}"
                     ElementPrepared="OnDetailsHeaderElementPrepared">
        <ItemsRepeater.Layout>
          <StackLayout Orientation="Horizontal" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="shellapi:DetailsColumn">
            <!--
              Outer Grid is the full-width column cell.
              Child 0: inner content Grid (header text + sort indicator, clipped + padded).
              Child 1: the gripper Border — OnDetailsHeaderElementPrepared wires it by index.
            -->
            <Grid Width="{x:Bind Width, Mode=OneWay}"
                  Height="{StaticResource DetailsHeaderHeight}"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Tag="{x:Bind Key}"
                  Tapped="OnColumnHeaderTapped">
              <!-- Child 0: header label area with ellipsis -->
              <Grid VerticalAlignment="Center" Margin="6,0,16,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Header}"
                           FontWeight="Normal" FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind SortIndicator, Mode=OneWay}"
                           FontWeight="Normal" FontSize="12"
                           VerticalAlignment="Center" />
              </Grid>
              <!-- Child 1: gripper — wired by OnDetailsHeaderElementPrepared via child index -->
              <Border Tag="{x:Bind Key}" Width="8" HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="Transparent" BorderThickness="0,0,1,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>

      <!-- Drop indicator shown during column drag-reorder (Details mode only) -->
      <Rectangle x:Name="ColumnDropIndicator"
                 Width="2" VerticalAlignment="Stretch"
                 HorizontalAlignment="Left"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 Canvas.ZIndex="10" />
    </Grid>

    <!-- Drag-ghost overlay: spans both rows, non-hit-testable so pointer events reach header -->
    <Canvas x:Name="ColDragCanvas"
            Grid.Row="0" Grid.RowSpan="2"
            IsHitTestVisible="False">
      <Border x:Name="ColDragGhost"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="6,4"
              Opacity="0.85"
              Visibility="Collapsed">
        <TextBlock x:Name="ColDragGhostText"
                   FontSize="12"
                   VerticalAlignment="Center" />
      </Border>
    </Canvas>

    <!-- Shell ListView -->
    <Grid Grid.Row="1" x:Name="DragSelectGrid">
      <ListView x:Name="ShellView"
                      SelectionMode="Extended"
                      DoubleTapped="ShellView_DoubleTapped"
                      RightTapped="OnShellViewRightTapped"
                      AllowDrop="True"
                      DragOver="OnShellViewDragOver"
                      DragLeave="OnShellViewDragLeave"
                      Drop="OnShellViewDrop"
                      KeyDown="OnShellViewKeyDown"
                      Padding="8">
        <ListView.Transitions>
          <TransitionCollection />
        </ListView.Transitions>
        <ListView.ItemContainerTransitions>
          <TransitionCollection />
        </ListView.ItemContainerTransitions>
        <ListView.GroupStyle>
          <GroupStyle HidesIfEmpty="False">
            <GroupStyle.HeaderTemplate>
              <DataTemplate x:DataType="local:ShellItemGroup">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="GroupHeader_Click">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Padding="4,6,4,4"
                        Margin="0,4,0,0">
                    <Grid.BorderBrush>
                      <SolidColorBrush Color="Transparent" />
                    </Grid.BorderBrush>
                    <!-- chevron -->
                    <FontIcon Grid.Column="0"
                              Glyph="{Binding ChevronGlyph}"
                              FontSize="11"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <!-- group name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Key}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <!-- collapsed count hint -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding CountText}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
      </ListView>

      <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
        <Rectangle x:Name="SelectionRect"
                           Visibility="Collapsed"
                           StrokeThickness="1"
                           Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                           Opacity="0.25"
                           Canvas.Left="0" Canvas.Top="0"
                           Width="0" Height="0" />
      </Canvas>

      <!-- Shared popup for expanded icon-mode label.
                 The card covers the label row (61 px, transparent — SelectionBorder shows through)
                 plus any overflow text below the item boundary.
                 NameExpansionOverflowFill is sized in code via SizeChanged to fill only the
                 overflow portion (below 61 px), so there is no double-background inside the item. -->
      <Popup x:Name="NameExpansionPopup" IsOpen="False">
        <Border x:Name="NameExpansionCard"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2,0,2,2"
                        CornerRadius="0,0,4,4"
                        MinHeight="47.5"
                        SizeChanged="OnNameExpansionCardSizeChanged">
          <Grid>
            <Rectangle x:Name="NameExpansionOverflowFill"
                                   Fill="{ThemeResource ListViewItemBackgroundSelected}"
                                   VerticalAlignment="Bottom"
                                   Height="0" />
            <Rectangle x:Name="NameExpansionOverflowFill2"
                                   Fill="{ThemeResource ListViewItemBackgroundSelected}"
                                   VerticalAlignment="Bottom"
                                   Height="0" />
            <TextBlock x:Name="NameExpansionText"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="2,4,2,6" />
          </Grid>
        </Border>
      </Popup>

      <!-- Inline rename TextBox — created and positioned in code-behind -->
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Padding="12,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="StatusTotalText"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle x:Name="StatusDivider"
                   Width="1"
                   Height="12"
                   VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="StatusSelectionText"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
