<Window
    x:Class="BetterExplorer.Controls.FtpSiteManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Manage FTP Sites">

  <Grid Padding="20" RowSpacing="12" MinWidth="520" MinHeight="380"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <TextBlock Grid.Row="0" Text="Manage FTP / SFTP / SCP Sites"
               Style="{ThemeResource SubtitleTextBlockStyle}" />

    <!-- Site list -->
    <ListView x:Name="SiteListView"
              Grid.Row="1"
              ItemsSource="{x:Bind Sites}"
              SelectionChanged="SiteListView_SelectionChanged"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:FtpSiteEntry">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="16" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
              <TextBlock Opacity="0.65" FontSize="11">
                <Run Text="{x:Bind Protocol}" />
                <Run Text="://" />
                <Run Text="{x:Bind Host}" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Action buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button x:Name="AddButton"    Content="Add…"    Click="AddButton_Click" />
      <Button x:Name="EditButton"   Content="Edit…"   Click="EditButton_Click"   IsEnabled="False" />
      <Button x:Name="DeleteButton" Content="Delete"  Click="DeleteButton_Click" IsEnabled="False" />
    </StackPanel>

    <!-- Close button -->
    <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right"
            Click="CloseButton_Click"
            Style="{ThemeResource AccentButtonStyle}" />
  </Grid>
</Window>
