<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterExplorer.Controls.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="960">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <NavigationView x:Name="SettingsNav"
                    Grid.Row="0"
                    Height="524"
                    PaneDisplayMode="Left"
                    OpenPaneLength="200"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    SelectionChanged="OnNavSelectionChanged">

      <NavigationView.MenuItems>
        <NavigationViewItem Content="General"    Tag="General"    IsSelected="True" />
        <NavigationViewItem Content="Appearance" Tag="Appearance" />
        <NavigationViewItem Content="About"      Tag="About" />
      </NavigationView.MenuItems>

      <!-- Frame is the content area; pages navigate into it -->
      <Frame x:Name="ContentFrame" />

    </NavigationView>

    <!-- Footer: 120 px wide, right-aligned Close button -->
    <Border Grid.Row="1" Margin="0,24,0,-4">
      <Button x:Name="FooterCloseButton"
              Width="120"
              MinWidth="120"
              MaxWidth="120"
              HorizontalAlignment="Right"
              Content="Close"
              Style="{StaticResource AccentButtonStyle}"
              Click="OnFooterCloseClick" />
    </Border>

  </Grid>

</UserControl>