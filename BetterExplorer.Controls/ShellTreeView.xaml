<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterExplorer.Controls.ShellTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellapi="using:BetterExplorer.ShellApi"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <UserControl.Resources>

    <!-- Explorer-style TreeViewItem -->
    <Style TargetType="TreeViewItem">
      <Setter Property="Padding"                    Value="0" />
      <Setter Property="MinHeight"                  Value="0" />
      <Setter Property="HorizontalAlignment"        Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsTabStop"                  Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>

              <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />

                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="BackgroundRect.Fill"
                              Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="BackgroundRect.Fill"
                              Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="Selected">
                    <VisualState.Setters>
                      <Setter Target="BackgroundRect.Fill"
                              Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                      <Setter Target="SelectionPill.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="SelectedPointerOver">
                    <VisualState.Setters>
                      <Setter Target="BackgroundRect.Fill"
                              Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                      <Setter Target="SelectionPill.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="SelectedPressed">
                    <VisualState.Setters>
                      <Setter Target="BackgroundRect.Fill"
                              Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                      <Setter Target="SelectionPill.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>

                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="ExpansionStates">
                  <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                      <Setter Target="CollapsedChevron.Visibility" Value="Visible" />
                      <Setter Target="ExpandedChevron.Visibility"  Value="Collapsed" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                      <Setter Target="CollapsedChevron.Visibility" Value="Collapsed" />
                      <Setter Target="ExpandedChevron.Visibility"  Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>

              </VisualStateManager.VisualStateGroups>

              <!-- Item row -->
              <Grid Height="24">

                <!-- Full-width hover / selection background -->
                <Rectangle x:Name="BackgroundRect"
                           Fill="Transparent"
                           RadiusX="3" RadiusY="3"
                           Margin="2,1" />

                <!-- Left-edge selection pill (NavigationView style) -->
                <Rectangle x:Name="SelectionPill"
                           Width="3" Height="16"
                           RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                           Opacity="0" />

                <!-- Indented content: chevron + item content -->
                <Grid Padding="{Binding RelativeSource={RelativeSource TemplatedParent},
                                        Path=TreeViewItemTemplateSettings.Indentation}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*"  />
                  </Grid.ColumnDefinitions>

                  <!-- Expand / collapse chevron -->
                  <Grid x:Name="ExpandCollapseChevron"
                        Grid.Column="0"
                        Width="18" Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{TemplateBinding Tag}">
                    <FontIcon x:Name="CollapsedChevron"
                              Glyph="&#xE76C;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="8"
                              Opacity="0.65"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <FontIcon x:Name="ExpandedChevron"
                              Glyph="&#xE70D;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="8"
                              Opacity="0.65"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </Grid>

                  <!-- Item content (icon + label from DataTemplate) -->
                  <ContentPresenter x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                </Grid>
              </Grid>

              <!-- Nested children -->
              <ItemsPresenter />

            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Node content template -->
    <DataTemplate x:Key="TreeNodeTemplate" x:DataType="shellapi:ShellTreeNode">
      <TreeViewItem ItemsSource="{x:Bind Children,              Mode=OneWay}"
                    IsExpanded="{x:Bind IsExpanded,             Mode=TwoWay}"
                    HasUnrealizedChildren="{x:Bind HasChildren, Mode=OneWay}"
                    Tag="{x:Bind ChevronVisibility,             Mode=OneWay}"
                    Margin="{x:Bind TopMargin}"
                    AutomationProperties.Name="{x:Bind Name,    Mode=OneWay}">
        <TreeViewItem.Content>
          <Grid ColumnSpacing="4" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*"  />
            </Grid.ColumnDefinitions>

            <!-- Shell icon with async-loading spinner overlay -->
            <Grid Grid.Column="0" Width="16" Height="16">
              <Image Source="{x:Bind Icon, Mode=OneWay}"
                     Stretch="UniformToFill" />
              <ProgressRing Width="14" Height="14"
                            IsActive="{x:Bind IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind LoadingVisibility, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Display name -->
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Name, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       FontSize="12"
                       FontFamily="Segoe UI Variable Text" />
          </Grid>
        </TreeViewItem.Content>
      </TreeViewItem>
    </DataTemplate>

  </UserControl.Resources>

  <TreeView x:Name="NavTree"
            Background="Transparent"
            ItemsSource="{x:Bind Roots}"
            ItemTemplate="{StaticResource TreeNodeTemplate}"
            SelectionMode="Single"
            CanDragItems="False"
            CanReorderItems="False"
            AllowDrop="False"
            Padding="0,4,0,4"
            ItemInvoked="NavTree_ItemInvoked" />

</UserControl>
