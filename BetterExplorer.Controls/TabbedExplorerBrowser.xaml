<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterExplorer.Controls.TabbedExplorerBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <Grid x:Name="ContentGrid">

    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TabViewItemSeparatorBrush"     Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="TabViewBackground"             Color="Transparent" />
            <!-- White tint on dark Mica: selected tab + content area + loading overlay -->
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#80303030" />
            <SolidColorBrush x:Key="TabViewContentBackground"      Color="#80303030" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TabViewItemSeparatorBrush"     Color="{ThemeResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="TabViewBackground"             Color="Transparent" />
            <!-- Black tint on light Mica: selected tab + content area + loading overlay -->
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#4FE8E7E7" />
            <SolidColorBrush x:Key="TabViewContentBackground"      Color="#4FE8E7E7" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>

    <TabView x:Name="Tabs"
             Visibility="Collapsed"
             IsAddTabButtonVisible="True"
             CanReorderTabs="True"
             CanDragTabs="True"
             TabWidthMode="SizeToContent"
             VerticalAlignment="Stretch"
             AddTabButtonClick="OnAddTabButtonClick"
             TabCloseRequested="OnTabCloseRequested"
             SelectionChanged="OnTabSelectionChanged">

      <!--
        TabStripHeader: a passive drag region to the left of the first tab.
        Its width is set from code-behind to match AppWindowTitleBar.LeftInset
        (the system icon / snap-layout area on the left).
      -->
      <TabView.TabStripHeader>
        <Border x:Name="TitleBarDragLeft" Width="0" />
      </TabView.TabStripHeader>

      <!--
        TabStripFooter: a passive drag region to the right of the + button.
        Its width is set from code-behind to match AppWindowTitleBar.RightInset
        (the caption-button cluster width) so tabs never slide under those buttons.
      -->
      <TabView.TabStripFooter>
        <Border x:Name="TitleBarDragRight" Width="0" />
      </TabView.TabStripFooter>

    </TabView>

    <!--
      Loading overlay: visible until the active tab's content finishes loading AND has
      visually settled. It is declared after Tabs in this Grid, so it fully covers Tabs
      in z-order. RevealTabsAsync (code-behind) makes Tabs visible and selects the last
      tab WHILE this overlay is still Visible on top — letting layout/container
      realization/icon paint happen hidden underneath it — and only collapses this
      overlay once that has settled, so the user never sees the tab's content build up.
    -->
    <Grid x:Name="LoadingOverlay"
          Background="Transparent"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <ProgressRing IsActive="True" Width="40" Height="40" />
        <TextBlock Text="Loading…"
                   HorizontalAlignment="Center"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
