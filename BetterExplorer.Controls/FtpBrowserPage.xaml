<UserControl
    x:Class="BetterExplorer.Controls.FtpBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BetterExplorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*"    />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Header bar ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="0" Padding="8,6" ColumnSpacing="8"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*"    />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <FontIcon Grid.Column="0" Glyph="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="20"
                VerticalAlignment="Center" />

      <TextBlock Grid.Column="1" x:Name="SiteTitleText"
                 Text="FTP Browser"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 FontSize="14"
                 TextTrimming="CharacterEllipsis" />

      <Button Grid.Column="2" x:Name="UpButton"
              ToolTipService.ToolTip="Go up one level"
              Click="UpButton_Click"
              IsEnabled="False">
        <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" />
      </Button>

      <Button Grid.Column="3" x:Name="RefreshButton"
              ToolTipService.ToolTip="Refresh"
              Click="RefreshButton_Click">
        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
      </Button>

      <Button Grid.Column="4" x:Name="DisconnectButton"
              Content="Disconnect"
              Click="DisconnectButton_Click" />
    </Grid>

    <!-- ── Breadcrumb path ─────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Padding="8,4"
            Background="{ThemeResource LayerFillColorAltBrush}">
      <TextBlock x:Name="PathText"
                 Text="/"
                 VerticalAlignment="Center"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- ── File area ───────────────────────────────────────────────────── -->
    <Grid Grid.Row="2">

      <!-- Busy overlay -->
      <ProgressRing x:Name="BusyRing"
                    Width="48" Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />

      <!-- Error panel -->
      <StackPanel x:Name="ErrorPanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="40"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="ErrorText"
                   TextWrapping="Wrap"
                   MaxWidth="400"
                   TextAlignment="Center" />
        <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Center"
                Click="RetryButton_Click" />
      </StackPanel>

      <!-- ── Icons view (WrapGrid) ─────────────────────────────────────── -->
      <GridView x:Name="IconsPanel"
                ItemsSource="{x:Bind RemoteItems}"
                SelectionMode="Single"
                Visibility="Collapsed"
                DoubleTapped="ListView_DoubleTapped">
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="local:RemoteFsItem">
            <StackPanel Width="80" Spacing="4" Padding="4"
                        HorizontalAlignment="Center">
              <FontIcon Glyph="{x:Bind Icon}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="32"
                        HorizontalAlignment="Center" />
              <TextBlock Text="{x:Bind Name}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <!-- ── List view (compact, name + icon only) ─────────────────────── -->
      <ListView x:Name="ListPanel"
                ItemsSource="{x:Bind RemoteItems}"
                SelectionMode="Single"
                Visibility="Collapsed"
                DoubleTapped="ListView_DoubleTapped">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:RemoteFsItem">
            <StackPanel Orientation="Horizontal" Spacing="8" Height="26">
              <FontIcon Glyph="{x:Bind Icon}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- ── Details view (Name / Size / Modified / Type) ──────────────── -->
      <ListView x:Name="DetailsPanel"
                ItemsSource="{x:Bind RemoteItems}"
                SelectionMode="Single"
                Visibility="Visible"
                DoubleTapped="ListView_DoubleTapped">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:RemoteFsItem">
            <Grid ColumnSpacing="8" Height="28">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"  />
                <ColumnDefinition Width="*"   />
                <ColumnDefinition Width="90"  />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90"  />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0"
                        Glyph="{x:Bind Icon}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Opacity="0.7" FontSize="11" />
              <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}"
                         VerticalAlignment="Center"
                         Opacity="0.7" FontSize="11" />
              <TextBlock Grid.Column="4" Text="{x:Bind TypeText}"
                         VerticalAlignment="Center"
                         Opacity="0.7" FontSize="11" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
        <!-- Column headers row -->
        <ListView.Header>
          <Grid ColumnSpacing="8" Padding="12,4,12,4"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20"  />
              <ColumnDefinition Width="*"   />
              <ColumnDefinition Width="90"  />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="90"  />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name"     FontWeight="SemiBold" FontSize="11" Opacity="0.8" />
            <TextBlock Grid.Column="2" Text="Size"     FontWeight="SemiBold" FontSize="11" Opacity="0.8" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" FontSize="11" Opacity="0.8" />
            <TextBlock Grid.Column="4" Text="Type"     FontWeight="SemiBold" FontSize="11" Opacity="0.8" />
          </Grid>
        </ListView.Header>
      </ListView>

    </Grid>

    <!-- ── Status bar ─────────────────────────────────────────────────── -->
    <Border Grid.Row="3"
            Padding="8,3"
            Background="{ThemeResource LayerFillColorAltBrush}">
      <TextBlock x:Name="StatusText"
                 Text="Not connected"
                 FontSize="11"
                 Opacity="0.7" />
    </Border>
  </Grid>
</UserControl>
